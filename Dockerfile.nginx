# Dockerfile.nginx

# --- Build client first ---
FROM oven/bun:1 AS client-builder

WORKDIR /app/client

COPY client/package.json client/bun.lockb* ./
RUN bun install

COPY client/ ./
RUN bunx vite build

# --- Nginx runtime ---
FROM nginx:alpine

# Use the default nginx.conf (it already includes mime.types)
# We only replace the default server config
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Remove any existing static content
RUN rm -rf /usr/share/nginx/html/*

# Copy built frontend from builder
COPY --from=client-builder /app/client/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
